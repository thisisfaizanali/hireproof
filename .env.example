# Variable names only. Local development values are in the README.

# API
PORT=
DATABASE_URL=

# Web app: where the server reaches the API
API_INTERNAL_URL=

# Local database (docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Seed: shared password for the demo users
SEED_DEMO_PASSWORD=

# Demo deployment only: quick-login buttons on the login page.
# These are readable in the browser, so never use a real password.
NEXT_PUBLIC_DEMO_LOGINS=
NEXT_PUBLIC_DEMO_PASSWORD=

# Optional: AI scorecard extraction and CV parsing through any OpenAI-compatible API.
# Without these the app still works and falls back to pattern matching.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_PARSE_MODEL is a smaller model for reading CVs (the README recommends openai/gpt-oss-20b),
# so the LLM_MODEL daily token budget goes to scoring.
LLM_PARSE_MODEL=
