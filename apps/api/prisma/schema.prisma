generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Industry {
  IT_SERVICES
  BANKING_BACK_OFFICE
  RETAIL
}

enum Role {
  RECRUITER
  CLIENT_HM
  DELIVERY_HEAD
}

model Client {
  id           String        @id @default(cuid())
  name         String
  industry     Industry
  createdAt    DateTime      @default(now())
  users        User[]
  requisitions Requisition[]
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String
  passwordHash          String
  role                  Role
  clientId              String?
  client                Client?           @relation(fields: [clientId], references: [id])
  createdAt             DateTime          @default(now())
  sessions              Session[]
  auditEvents           AuditEvent[]
  requisitions          Requisition[]
  confirmedScorecards   Scorecard[]
  uploadBatches         UploadBatch[]
  resolvedDuplicates    DuplicateLink[]
  decidedApplications   Application[]
  submittedApplications Application[]     @relation("submitter")
  proposedSlots         InterviewSlot[]
  outboundMessages      OutboundMessage[]
  consentRecords        ConsentRecord[]
  deletionRecords       DeletionRecord[]
  sampleReviews         SampleReview[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

enum RequisitionStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum ScorecardSource {
  AI
  RULES
  MANUAL
}

enum ScorecardStatus {
  DRAFT
  CONFIRMED
}

enum CriterionKind {
  MUST_HAVE
  NICE_TO_HAVE
}

enum AiOutcome {
  OK
  RETRIED_OK
  INVALID_OUTPUT
  PROVIDER_ERROR
  NOT_CONFIGURED
}

model Requisition {
  id           String            @id @default(cuid())
  number       Int               @unique @default(autoincrement())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id])
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  title        String
  jdText       String
  jdFileName   String?
  status       RequisitionStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  scorecard    Scorecard?
  aiRuns       AiRun[]
  batches      UploadBatch[]
  cvs          CvDocument[]
  applications Application[]

  @@index([clientId])
  @@index([status])
}

model Scorecard {
  id            String      @id @default(cuid())
  requisitionId String      @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  experienceMinYears Float?
  experienceMaxYears Float?
  experienceQuote    String?
  experienceReview   Boolean  @default(false)
  noticeMaxDays      Int?
  noticeQuote        String?
  noticeReview       Boolean  @default(false)
  ctcMaxLpa          Float?
  ctcQuote           String?
  ctcReview          Boolean  @default(false)
  locations          String[]
  locationsQuote     String?
  locationsReview    Boolean  @default(false)

  ambiguities   String[]
  // Of the confirmed criteria and ranges, so confirming an unchanged card changes nothing.
  contentHash   String?
  source        ScorecardSource
  model         String?
  status        ScorecardStatus @default(DRAFT)
  version       Int             @default(0)
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?           @relation(fields: [confirmedById], references: [id])
  criteria      Criterion[]
}

model Criterion {
  id          String        @id @default(cuid())
  scorecardId String
  scorecard   Scorecard     @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  kind        CriterionKind
  label       String
  sourceQuote String?
  needsReview Boolean       @default(false)
  position    Int

  @@index([scorecardId])
}

model AiRun {
  id            String       @id @default(cuid())
  kind          String
  requisitionId String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  model         String
  outcome       AiOutcome
  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?
  errorMessage  String?
  createdAt     DateTime     @default(now())

  @@index([requisitionId])
}

enum TextSource {
  TEXT_LAYER
  OCR
}

enum CvStatus {
  QUEUED
  EXTRACTING
  OCR
  PARSING
  PARSED
  NEEDS_REVIEW
  FAILED
  DUPLICATE_FILE
}

enum ParseSource {
  AI
  RULES
}

enum ApplicationStage {
  SOURCED
  SCREENED
  SUBMITTED
  CLIENT_SHORTLISTED
  INTERVIEW
  OFFERED
  JOINED
  REJECTED
  WITHDRAWN
}

enum DuplicateKind {
  EXACT_FILE
  CONTACT
  FUZZY
}

enum DuplicateStatus {
  AUTO_MERGED
  PENDING
  SAME_PERSON
  DIFFERENT_PEOPLE
}

model Candidate {
  id                   String          @id @default(cuid())
  code                 String          @unique @default(dbgenerated("'CND-' || lpad(nextval('candidate_code_seq')::text, 5, '0')"))
  name                 String
  email                String?
  phone                String?
  location             String?
  currentRole          String?
  totalExperienceYears Decimal?        @db.Decimal(4, 1)
  skills               String[]
  noticeText           String?
  noticeDays           Int?
  ctcText              String?
  currentCtcLpa        Decimal?        @db.Decimal(6, 2)
  expectedCtcLpa       Decimal?        @db.Decimal(6, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  // A CV upload or a stage change. Retention runs 12 months from here.
  lastActivityAt       DateTime        @default(now())
  cvs                  CvDocument[]
  applications         Application[]
  duplicateLinks       DuplicateLink[]
  consents             ConsentRecord[]

  @@index([email])
  @@index([phone])
  @@index([lastActivityAt])
}

model UploadBatch {
  id                String         @id @default(cuid())
  requisitionId     String
  requisition       Requisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User           @relation(fields: [uploadedById], references: [id])
  expectedCount     Int
  // Attested once for the batch. Null on batches from before consent was recorded.
  consentSource     ConsentSource?
  consentSourceNote String?
  consentAt         DateTime?
  createdAt         DateTime       @default(now())
  cvs               CvDocument[]

  @@index([requisitionId, createdAt])
}

model CvDocument {
  id             String          @id @default(cuid())
  candidateId    String?
  candidate      Candidate?      @relation(fields: [candidateId], references: [id])
  batchId        String
  batch          UploadBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  requisitionId  String
  requisition    Requisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  // Files stay in Postgres for now: move to object storage at real volume.
  // Deleting a candidate stays a single transaction while the bytes are here.
  data           Bytes
  text           String?
  redactedText   String?
  textSource     TextSource?
  ocrConfidence  Float?
  status         CvStatus        @default(QUEUED)
  reviewReasons  String[]
  failureReason  String?
  parseSource    ParseSource?
  // The parsed profile as read from this file, kept so the candidate profile can be rebuilt from the latest CV.
  profile        Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  duplicateLinks DuplicateLink[]
  consent        ConsentRecord?

  @@index([sha256])
  @@index([batchId])
  @@index([candidateId])
  @@index([requisitionId])
}

enum RejectReason {
  SKILLS_GAP
  EXPERIENCE
  NOTICE_PERIOD
  CTC
  LOCATION
  OTHER
}

enum RejectedBy {
  RECRUITER
  CLIENT
}

enum ClientRejectReason {
  SKILLS_GAP
  EXPERIENCE
  NOTICE_PERIOD
  CTC
  LOCATION
  ALREADY_INTERVIEWED
  OTHER
}

enum SlotMode {
  VIDEO
  IN_PERSON
}

enum SlotStatus {
  PROPOSED
  CONFIRMED
  DECLINED
}

enum MessageRecipient {
  CANDIDATE
  CLIENT
}

enum MessageChannel {
  EMAIL
}

enum MessageStatus {
  MOCKED
}

enum ScoreBand {
  STRONG
  POSSIBLE
  WEAK
}

enum ScoreSource {
  AI
  RULES
}

model Application {
  id                 String              @id @default(cuid())
  candidateId        String
  candidate          Candidate           @relation(fields: [candidateId], references: [id])
  requisitionId      String
  requisition        Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stage              ApplicationStage    @default(SOURCED)
  rejectReason       RejectReason?
  rejectNote         String?
  decidedById        String?
  decidedBy          User?               @relation(fields: [decidedById], references: [id])
  decidedAt          DateTime?
  submittedAt        DateTime?
  submittedById      String?
  submittedBy        User?               @relation("submitter", fields: [submittedById], references: [id])
  submissionNote     String?
  rejectedBy         RejectedBy?
  clientRejectReason ClientRejectReason?
  clientRejectNote   String?
  // Set while a score job runs, so the list can say "Scoring".
  scoringStartedAt   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  scores             CandidateScore[]
  slots              InterviewSlot[]
  messages           OutboundMessage[]
  sampleReviews      SampleReview[]

  @@unique([candidateId, requisitionId])
  @@index([requisitionId, createdAt])
}

model DuplicateLink {
  id           String          @id @default(cuid())
  cvId         String
  cv           CvDocument      @relation(fields: [cvId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate       @relation(fields: [candidateId], references: [id])
  kind         DuplicateKind
  similarity   Float?
  reason       String          @default("")
  status       DuplicateStatus
  resolvedById String?
  resolvedBy   User?           @relation(fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([status])
  @@index([cvId])
  @@index([candidateId])
}

model CandidateScore {
  id               String      @id @default(cuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scorecardVersion Int
  total            Int
  band             ScoreBand
  mustHavesMet     Int
  mustHavesTotal   Int
  experiencePoints Int
  criteria         Json
  flags            String[]
  source           ScoreSource
  model            String?
  stale            Boolean     @default(false)
  createdAt        DateTime    @default(now())

  @@unique([applicationId, scorecardVersion])
  @@index([applicationId])
}

// A time the client proposes for an interview. The recruiter confirms one.
model InterviewSlot {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startsAt        DateTime    @db.Timestamptz(3)
  durationMinutes Int
  mode            SlotMode
  note            String?
  status          SlotStatus  @default(PROPOSED)
  proposedById    String
  proposedBy      User        @relation(fields: [proposedById], references: [id])
  createdAt       DateTime    @default(now())

  @@index([applicationId])
}

// Messaging is mocked: the row records what would be sent, and nothing is sent.
model OutboundMessage {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recipient     MessageRecipient
  channel       MessageChannel   @default(EMAIL)
  subject       String
  body          String
  status        MessageStatus    @default(MOCKED)
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

enum ConsentBasis {
  APPLIED_OR_AGREED
}

enum ConsentSource {
  JOB_PORTAL
  REFERRAL
  DIRECT_APPLICATION
  AGENCY_DATABASE
  OTHER
}

// Why the firm holds a CV, attested by the recruiter who uploaded it.
model ConsentRecord {
  id            String        @id @default(cuid())
  cvId          String        @unique
  cv            CvDocument    @relation(fields: [cvId], references: [id], onDelete: Cascade)
  candidateId   String?
  candidate     Candidate?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  basis         ConsentBasis
  source        ConsentSource
  sourceNote    String?
  attestedById  String
  attestedBy    User          @relation(fields: [attestedById], references: [id])
  attestedAt    DateTime
  noticeVersion String

  @@index([candidateId])
}

enum DeletionReason {
  CANDIDATE_REQUEST
  RETENTION_ENDED
  UPLOADED_BY_MISTAKE
}

// What was erased and why. Holds the candidate code and counts, never a name,
// an email, a phone number or any CV text.
model DeletionRecord {
  id            String         @id @default(cuid())
  candidateCode String
  reason        DeletionReason
  deletedById   String
  deletedBy     User           @relation(fields: [deletedById], references: [id])
  deletedAt     DateTime       @default(now())
  counts        Json

  @@index([deletedAt])
}

enum SampleVerdict {
  AI_RIGHT
  RECRUITER_RIGHT
  BOTH_REASONABLE
}

// The delivery head's verdict on one decision in the weekly sample. The band,
// decision and requisition number are copied so the verdict survives the
// application being deleted.
model SampleReview {
  id                String        @id @default(cuid())
  weekStart         DateTime      @db.Date
  applicationId     String?
  application       Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  verdict           SampleVerdict
  note              String?
  reviewedById      String
  reviewedBy        User          @relation(fields: [reviewedById], references: [id])
  reviewedAt        DateTime      @default(now())
  band              ScoreBand?
  decision          String
  requisitionNumber Int

  @@unique([weekStart, applicationId])
  @@index([weekStart])
}
