{
  "name": "@hireproof/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "capture:scorecards": "tsx --env-file-if-exists=../../.env scripts/capture-scorecards.ts",
    "eval:jd": "tsx --env-file-if-exists=../../.env scripts/eval-jd.ts",
    "capture:cvs": "tsx --env-file-if-exists=../../.env scripts/capture-cvs.ts",
    "eval:cv": "tsx --env-file-if-exists=../../.env scripts/eval-cv.ts",
    "capture:scores": "tsx --env-file-if-exists=../../.env scripts/capture-scores.ts",
    "eval:score": "tsx --env-file-if-exists=../../.env scripts/eval-score.ts",
    "db:reband": "tsx --env-file-if-exists=../../.env scripts/reband-scores.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hireproof/shared": "*",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.51.0",
    "pg-boss": "^12.38.1",
    "prisma": "^7.10.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  }
}
